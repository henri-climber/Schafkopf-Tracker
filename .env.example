# Copy to .env and fill in the values from your Supabase project settings.
# Both are read in src/shared/supabase/client.ts, which throws at import time if either
# is missing — the app will not boot without them.
VITE_SUPABASE_URL_SCHAF=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY_SCHAF=your_supabase_anon_key
